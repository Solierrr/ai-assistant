# Chaves de API para os Modelos de Linguagem
GOOGLE_API_KEY=sua_chave_do_google_aqui
GROQ_API_KEY=sua_chave_do_groq_aqui

# Conexão com o Banco de Dados MongoDB para Persistência de Conversas
MONGODB_URI=mongodb://localhost:27017

# Redis dos agentes no Upstash
UPSTASH_REDIS_HOST=seu-banco-123456.upstash.io
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_USERNAME=default
UPSTASH_REDIS_PASSWORD=sua_senha_aqui

# Especificação da chave dos dados e o tamanho máximo de registros até o corte
AGENT_STREAM_CHATBOT=agent:stream:chatbot
AGENT_STREAM_MAXLEN=1000
AGENT_STREAM_GROUP=chatbot-agents

# Especificação do consumer, chave do resultado da fila e TTL padrão dos dados
AGENT_CONSUMER_PREFIX=chatbot-consumer
AGENT_CONSUMER_BLOCK_MS=60000
AGENT_CONSUMER_BATCH_SIZE=1
AGENT_CONSUMER_CLAIM_IDLE_MS=300000
AGENT_CONSUMER_CLAIM_INTERVAL_MS=300000
AGENT_CONSUMER_COUNT=2
AGENT_CONSUMER_MAX_ATTEMPTS=3
AGENT_CONSUMER_IDLE_DELAY_MS=1000
AGENT_CONSUMER_RETRY_DELAY_MS=1000

AGENT_RESULT_PREFIX=agent:result:chatbot
AGENT_RESULT_TTL_SECONDS=900
