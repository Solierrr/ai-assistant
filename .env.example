# Chaves de API para os Modelos de Linguagem
GOOGLE_API_KEY=sua_chave_do_google_aqui
GROQ_API_KEY=sua_chave_do_groq_aqui

# Conexão com o Banco de Dados MongoDB (checkpointer de curto prazo do LangGraph)
MONGODB_URI=mongodb://localhost:27017

# api-messenger: conversas e mensagens passam a viver lá, não mais no Mongo local
API_MESSENGER_URL=http://localhost:8080

# Redis dos agentes no Upstash
UPSTASH_REDIS_HOST=seu-banco-123456.upstash.io
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_USERNAME=default
UPSTASH_REDIS_PASSWORD=sua_senha_aqui

# Não declare essa variável de ambiente para testar LOCAL, o default no settings.py é LOCAL.
# Essa variavel muda nas envs de QA e PROD.
ENVIRONMENT=LOCAL

# Só pra rodar main.py localmente (JWT de usuário via mock-idp ou api-auth)
TEST_USER_TOKEN=seu_token_de_teste_aqui

# api-mcp: tools de solar_panel_specialist/professional_suggester (mesmo MCP_API_KEY do .env do api-mcp)
MCP_URL=http://localhost:8001/mcp
MCP_API_KEY=troque-por-uma-chave-forte-de-verdade


DEMO_MODE=false
GOOGLE_SOLAR_API_KEY=sua_chave_do_google_solar_aqui
SOLAR_API_URL=https://solar.googleapis.com/v1/buildingInsights:findClosest
SOLAR_API_AUTH_MODE=google_api_key
GEOCODING_API_URL=https://maps.googleapis.com/maps/api/geocode/json

# solar_calculator: fonte do potencial solar.
# "google_direct"   -> chama a Solar API do Google direto deste projeto (padrão atual).
# "google_registry" -> consulta o serviço centralizado google-registry
#                       (GET /v1/solar/roof-viability) em vez de chamar o Google direto.
SOLAR_DATA_SOURCE=google_direct
GOOGLE_REGISTRY_URL=http://localhost:8000
GOOGLE_REGISTRY_AUTH_TOKEN=seu_token_de_servico_para_o_google_registry_aqui

REQUEST_TIMEOUT_SECONDS=15.0
HTTP_MAX_ATTEMPTS=3
DEFAULT_TARIFF_REAIS_KWH=0.95
PANEL_REFERENCE=JA Solar JAM72S30-550/MR
PANEL_POWER_WATTS=550.0
PANEL_WIDTH_METERS=1.134
PANEL_HEIGHT_METERS=2.278
PANEL_MODULE_REFERENCE_PRICE_REAIS=780.0
INSTALLATION_LABOR_COST_PER_PANEL_REAIS=632.5
OTHER_SYSTEM_COST_PER_PANEL_REAIS=387.5
FALLBACK_PANEL_MONTHLY_KWH=65.0
SYSTEM_PERFORMANCE_RATIO=0.85
ANNUAL_PANEL_DEGRADATION_RATE=0.0055
