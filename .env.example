# Fonte de verdade real é o Infisical — este arquivo só documenta quais
# variáveis existem. Ver design em docs-warehouse/architecture.

# /llm
GOOGLE_API_KEY=sua_chave_do_google_aqui
GROQ_API_KEY=sua_chave_do_groq_aqui
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=12
GEMINI_MAX_RETRIES=0
GEMINI_MAX_TOKENS=2048
GEMINI_THINKING_LEVEL=minimal
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_QUALITY_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=8
GROQ_MAX_RETRIES=0
GROQ_MAX_TOKENS=1024

# /database (checkpointer de curto prazo do LangGraph)
DB_MONGO_URI=mongodb://localhost:27017
DB_MONGO_AGENTS=assessor_inteligente

# api-messenger: conversas e mensagens passam a viver lá, não mais no Mongo local
API_MESSENGER_URL=http://localhost:8080
API_MESSENGER_TIMEOUT_SECONDS=10

# Redis dos agentes no Upstash
UPSTASH_AGENTS_HOST=seu-banco-123456.upstash.io
UPSTASH_AGENTS_PORT=6379
UPSTASH_AGENTS_USERNAME=default
UPSTASH_AGENTS_PASSWORD=sua_senha_aqui

# solaria-core: armazenamento temporário criptografado do mapa PII
UPSTASH_CORE_HOST=seu-banco-core.upstash.io
UPSTASH_CORE_PORT=6379
UPSTASH_CORE_USERNAME=default
UPSTASH_CORE_PASSWORD=sua_senha_do_solaria_core
# Gere uma chave AES-256 URL-safe Base64 e guarde-a no Infisical.
PII_ENCRYPTION_KEY=chave_base64_urlsafe_de_32_bytes
PII_MAP_IDLE_TTL_SECONDS=1800
PII_MAP_MAX_TTL_SECONDS=86400

# Fila assíncrona do chatbot
AGENT_STREAM_CHATBOT=agent:stream:chatbot
AGENT_STREAM_GROUP=chatbot-agents
AGENT_STREAM_MAXLEN=1000
AGENT_RESULT_PREFIX=agent:result:chatbot
AGENT_RESULT_TTL_SECONDS=900
AGENT_CONSUMER_PREFIX=chatbot-consumer
AGENT_CONSUMER_COUNT=2
AGENT_CONSUMER_BLOCK_MS=60000
AGENT_CONSUMER_BATCH_SIZE=1
AGENT_CONSUMER_CLAIM_BATCH_SIZE=10
AGENT_CONSUMER_CLAIM_IDLE_MS=300000
AGENT_CONSUMER_CLAIM_INTERVAL_MS=300000
AGENT_CONSUMER_IDLE_DELAY_MS=1000
AGENT_CONSUMER_RETRY_DELAY_MS=1000
AGENT_CONSUMER_MAX_RETRY_DELAY_MS=30000
AGENT_PROCESSING_TIMEOUT_SECONDS=50

# Não declare essa variável de ambiente para testar LOCAL, o default no settings.py é LOCAL.
# Essa variavel muda nas envs de QA e PROD.
ENVIRONMENT=LOCAL

# Só pra rodar main.py localmente (JWT de usuário via mock-idp ou api-auth)
TEST_USER_TOKEN=seu_token_de_teste_aqui

# api-mcp: tools de solar_panel_specialist/professional_suggester (mesmo MCP_API_KEY do .env do api-mcp)
MCP_URL=http://localhost:8001/mcp
MCP_API_KEY=troque-por-uma-chave-forte-de-verdade
