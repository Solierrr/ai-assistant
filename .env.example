# Chaves de API para os Modelos de Linguagem
GEMINI_API_KEY=sua_chave_do_gemini_aqui
GROQ_API_KEY=sua_chave_do_groq_aqui
OPENAI_API_KEY=sua_chave_da_openai_aqui
LLM_MODEL_OPENAI=gpt-6-luna
LLM_PROVIDER_ORDER=gemini,groq,openai

# Conexão com o Banco de Dados MongoDB (checkpointer de curto prazo do LangGraph)
MONGODB_URI=mongodb://localhost:27017

# Banco compartilhado pelos agentes (memória e checkpoints). Em QA use dbagentsqa.
DB_MONGO_AGENTS=dbagents

# api-messenger: conversas e mensagens passam a viver lá, não mais no Mongo local
API_MESSENGER_URL=http://localhost:8080

# /service-keys
SERVICE_KEY=

# Não declare essa variável de ambiente para testar LOCAL, o default no settings.py é LOCAL.
# Essa variavel muda nas envs de QA e PROD.
ENVIRONMENT=LOCAL

# Swagger (/docs) e contrato (/openapi.json); false em PROD.
DOCS_ENABLED=true

DEBUG_ADMIN_SUBS=

# Validação do JWT de usuário (RS256/JWKS, emitido pelo api-auth).
# Local: o JWKS do api-auth que roda na sua máquina (/.well-known/jwks.json).
JWT_JWKS_URL=
JWT_ISSUER=solaria-auth

# Origens do navegador autorizadas a chamar a API (CORS), separadas por vírgula.
# Em QA e PROD liste só os domínios reais do web-app; nunca use *.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# mcp-database: tools de solar_panel_specialist/professional_suggester. Autentica com o
# SERVICE_KEY acima (X-Service-Key); MCP_API_KEY só enquanto o mcp-database aceitar a chave antiga.
MCP_URL=http://localhost:8001/mcp
MCP_API_KEY=

# api-core (unidades do usuário, lidas com o JWT dele)
API_CORE_URL=http://localhost:8080/api

# A2A: URL pública deste serviço (Agent Card) e a do ai-operational, para onde o
# assistente delega ações do SaaS. Na pasta de produção use as URLs do Render/GKE.
A2A_PUBLIC_URL=http://localhost:8000
A2A_OPERATIONAL_URL=http://localhost:8003

# Qdrant Cloud: coleção faq (RAG do faq_retriever)
QDRANT_URL=https://sua-instancia.cloud.qdrant.io
QDRANT_API_KEY=sua_chave_do_qdrant_aqui

SOLARIA_LANGSMITH_ENABLED=false
SOLARIA_LANGSMITH_API_KEY=sua_chave_do_langsmith_aqui
SOLARIA_LANGSMITH_PROJECT=solaria-qa

# OpenTelemetry is opt-in; coordinate cluster activation with infrastructure.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
DEPLOYMENT_ENVIRONMENT=local
